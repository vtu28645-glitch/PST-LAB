import java.util.*;

class Solution {
    public List<String> findAndReplacePattern(String[] words, String pattern) {
        List<String> result = new ArrayList<>();
        
        for (String word : words) {
            if (matches(word, pattern)) {
                result.add(word);
            }
        }
        
        return result;
    }
    
    private boolean matches(String word, String pattern) {
        int[] patternToWord = new int[256];
        int[] wordToPattern = new int[256];
        
        for (int i = 0; i < word.length(); i++) {
            char pChar = pattern.charAt(i);
            char wChar = word.charAt(i);
            
            // Check if pattern character is already mapped to a different word character
            if (patternToWord[pChar] != 0 && patternToWord[pChar] != wChar) {
                return false;
            }
            
            // Check if word character is already mapped to a different pattern character
            if (wordToPattern[wChar] != 0 && wordToPattern[wChar] != pChar) {
                return false;
            }
            
            patternToWord[pChar] = wChar;
            wordToPattern[wChar] = pChar;
        }
        
        return true;
    }
}
