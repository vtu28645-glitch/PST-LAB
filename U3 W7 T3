import java.util.*;

class UndergroundSystem {

    // id -> check-in station and time
    private Map<Integer, String> checkInStation;
    private Map<Integer, Integer> checkInTime;

    // route -> total travel time and number of trips
    private Map<String, Integer> totalTime;
    private Map<String, Integer> tripCount;

    public UndergroundSystem() {
        checkInStation = new HashMap<>();
        checkInTime = new HashMap<>();
        totalTime = new HashMap<>();
        tripCount = new HashMap<>();
    }

    public void checkIn(int id, String stationName, int t) {
        checkInStation.put(id, stationName);
        checkInTime.put(id, t);
    }

    public void checkOut(int id, String stationName, int t) {
        String startStation = checkInStation.get(id);
        int startTime = checkInTime.get(id);

        String route = startStation + "#" + stationName;
        int travelTime = t - startTime;

        totalTime.put(route, totalTime.getOrDefault(route, 0) + travelTime);
        tripCount.put(route, tripCount.getOrDefault(route, 0) + 1);

        checkInStation.remove(id);
        checkInTime.remove(id);
    }

    public double getAverageTime(String startStation, String endStation) {
        String route = startStation + "#" + endStation;

        return (double) totalTime.get(route) / tripCount.get(route);
    }
}
